{
  // 关键：${fileBasenameNoExtension} 取当前文件（tests/1004.cpp → 1004）
  "version": "2.0.0",
  "tasks": [
    {
      "label": "make 当前测试",
      "type": "shell",
      "command": "make",
      "args": ["out/${fileBasenameNoExtension}"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "make all",
      "type": "shell",
      "command": "make",
      "args": ["-j4"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "make clean",
      "type": "shell",
      "command": "make",
      "args": ["clean"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
