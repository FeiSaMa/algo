{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "gdb 调试当前题",
      // 在 tests/56.cpp 或 leetcode/56.merge-intervals.cpp 里按 F5 都行：
      // 先跑 "构建当前题"（→ out/56，并把 out/current 指向它），再调试 out/current。
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/out/current",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      // 集成终端做 stdin/stdout：测试里写 std::cin 也能调试
      "console": "integratedTerminal",
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "targetArchitecture": "x86_64",
      // F11 只进你自己的代码，不进 /usr/include/c++
      "justMyCode": true,
      "preLaunchTask": "构建当前题",
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}
